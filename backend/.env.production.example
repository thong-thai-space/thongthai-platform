NODE_ENV=production
PORT=4000
POSTGRES_USER=thongthai
POSTGRES_DB=thongthai_space
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Database
DATABASE_URL=postgresql://thongthai:CHANGE_ME_DB_PASSWORD@postgres:5432/thongthai_space?schema=public

# Cache
REDIS_URL=redis://redis:6379

# CORS
FRONTEND_URL=https://your-frontend-domain.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-backend-domain.com/api/auth/google/callback

# JWT
JWT_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI Provider Router (plan §6.4) ──
# Active LLM provider: claude (default) | openai | gemini. Env validation requires
# ONLY the selected provider's key, so switching providers is config-only.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY   # required when AI_PROVIDER=claude
OPENAI_API_KEY=                                  # required when AI_PROVIDER=openai
OPENAI_MODEL=                                    # optional, default gpt-4o-mini
GEMINI_API_KEY=                                  # required when AI_PROVIDER=gemini
GEMINI_MODEL=                                    # optional, default gemini-1.5-flash

# ── RAG knowledge base (GĐ2) ──
# Voyage AI embeddings. Leave blank to disable RAG ingestion/query (app still boots).
# Standalone Voyage key (not a MongoDB Atlas key): https://dashboard.voyageai.com
VOYAGE_API_KEY=

# ── Error reporting / observability ──
# Sentry DSN — leave blank to disable. Logs are structured JSON on stdout in prod.
SENTRY_DSN=

# ── Object storage for uploads (CMS images, avatars, portfolio) ──
# STORAGE_PROVIDER=local serves files from the backend's /uploads volume.
# Set STORAGE_PROVIDER=r2 + all five R2_* values to use Cloudflare R2.
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Example: R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ── Bot protection (Cloudflare Turnstile) ──
# Leave blank to disable; when set, auth + contact endpoints require a token.
TURNSTILE_SECRET_KEY=

# ── Email (Resend) ──
RESEND_API_KEY=

# ── Web Push (VAPID) — generate with: npx web-push generate-vapid-keys ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com
