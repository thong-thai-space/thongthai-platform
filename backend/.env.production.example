NODE_ENV=production
PORT=4000
STORAGE_PROVIDER=local
POSTGRES_USER=thongthai
POSTGRES_DB=thongthai_space
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Database
DATABASE_URL=postgresql://thongthai:CHANGE_ME_DB_PASSWORD@postgres:5432/thongthai_space?schema=public

# Cache
REDIS_URL=redis://redis:6379

# CORS
FRONTEND_URL=https://your-frontend-domain.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-backend-domain.com/api/auth/google/callback

# JWT
JWT_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY

# Optional integrations
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
RESEND_API_KEY=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hoangthai229@gmail.com

# Example:
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
