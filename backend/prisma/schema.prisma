generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  CLIENT
}

enum ProjectStatus {
  DRAFT
  PROPOSAL_SENT
  IN_PROGRESS
  ON_HOLD
  REVIEW
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  PROJECT_UPDATE
  PROJECT_REQUEST
  CONTACT_REQUEST
  INVOICE_PAID
  CLIENT_MESSAGE
  AI_COMPLETED
  SYSTEM
}

enum Language {
  VI
  EN
}

enum MotionPreference {
  SYSTEM
  ON
  OFF
}

enum Currency {
  VND
  USD
}

enum AiFeature {
  CHAT
  PROPOSAL
  TASK_BREAKDOWN
  CODE_REVIEW
  ESTIMATE
  PROGRESS_REPORT
  STRATEGIC_PLAN
  APPLY_STRATEGIC_PLAN
  PUBLIC_CHAT
  ARCHITECTURE_DIAGRAM
}

enum AiApplyRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum RagDocumentSource {
  UPLOAD
  TEXT
  URL
}

enum RagDocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

enum RagAnswerStatus {
  DRAFT
  APPROVED
  REJECTED
}

// Academy (GĐ2) — packaged AI-usage Playbooks delivered to clients (Dịch vụ 2).
enum PlaybookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PlaybookAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

// ==================== MODELS ====================

model User {
  id                     String           @id @default(cuid())
  email                  String           @unique
  googleId               String?          @unique
  emailVerified          Boolean          @default(false)
  emailVerifyToken       String?          @unique
  emailVerifyTokenExpiry DateTime?
  termsAcceptedAt        DateTime?
  privacyAcceptedAt      DateTime?
  password               String
  name                   String
  avatar                 String?
  phone                  String?
  role                   UserRole         @default(CLIENT)
  locale                 Language         @default(EN)
  motionPreference       MotionPreference @default(SYSTEM)
  isActive               Boolean          @default(true)
  refreshTokenHash       String?
  lastLoginAt            DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  // Pattern: Quota - AI usage limits per user (monthly resets)
  aiQuotaUsedTokens  Int      @default(0) // Cumulative tokens used this month
  aiQuotaLimitTokens Int      @default(100000) // Monthly token limit per user (configurable)
  aiQuotaResetDate   DateTime @default(now()) // Last reset date for monthly quota

  // Relations
  ownedProjects     Project[]          @relation("ProjectOwner")
  assignedTasks     Task[]             @relation("TaskAssignee")
  createdTasks      Task[]             @relation("TaskCreator")
  comments          Comment[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  aiConversations   AiConversation[]
  invoicesCreated   Invoice[]          @relation("InvoiceCreator")
  timeEntries       TimeEntry[]
  activities        Activity[]

  // Client relations
  clientProjects Project[] @relation("ProjectClient")
  clientInvoices Invoice[] @relation("InvoiceClient")

  // Messaging
  sentMessages             Message[]        @relation("MessageSender")
  receivedMessages         Message[]        @relation("MessageReceiver")
  aiUsageAudits            AiUsageAudit[]
  aiApplyRequestsSubmitted AiApplyRequest[] @relation("AiApplyRequester")
  aiApplyRequestsReviewed  AiApplyRequest[] @relation("AiApplyReviewer")

  // Pattern: Authorship — blog posts authored by this user
  blogPosts BlogPost[] @relation("BlogPostAuthor")

  // RAG knowledge base (clientId = tenant owner; uploader/asker/reviewer = staff)
  ragDocumentsOwned    RagDocument[] @relation("RagDocumentClient")
  ragDocumentsUploaded RagDocument[] @relation("RagDocumentUploader")
  ragAnswersOwned      RagAnswer[]   @relation("RagAnswerClient")
  ragAnswersAsked      RagAnswer[]   @relation("RagAnswerAsker")
  ragAnswersReviewed   RagAnswer[]   @relation("RagAnswerReviewer")

  // Academy (author = staff; assignment client = tenant owner; assigner = staff)
  playbooksAuthored        Playbook[]           @relation("PlaybookAuthor")
  playbookAssignmentsOwned PlaybookAssignment[] @relation("PlaybookAssignmentClient")
  playbookAssignmentsMade  PlaybookAssignment[] @relation("PlaybookAssignmentAssigner")

  @@map("users")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  deadline    DateTime?
  budget      Decimal?      @db.Decimal(15, 2)
  budgetUsd   Decimal?      @db.Decimal(15, 2)
  currency    Currency      @default(VND)

  // Tech stack & metadata
  techStack String[] @default([])
  repoUrl   String?
  liveUrl   String?
  figmaUrl  String?

  // Relations
  ownerId  String
  owner    User    @relation("ProjectOwner", fields: [ownerId], references: [id])
  clientId String?
  client   User?   @relation("ProjectClient", fields: [clientId], references: [id])

  tasks           Task[]
  invoices        Invoice[]
  comments        Comment[]
  files           ProjectFile[]
  milestones      Milestone[]
  activities      Activity[]
  messages        Message[]
  aiUsageAudits   AiUsageAudit[]
  aiApplyRequests AiApplyRequest[]

  // Portfolio
  isShowcase       Boolean  @default(false)
  showcaseOrder    Int?
  showcaseCategory String?
  showcaseResults  String?
  thumbnailUrl     String?
  screenshots      String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  estimatedHours Float?
  actualHours    Float?
  order          Int          @default(0)

  // Relations
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId   String
  creator     User       @relation("TaskCreator", fields: [creatorId], references: [id])
  parentId    String?
  parent      Task?      @relation("SubTasks", fields: [parentId], references: [id])
  subTasks    Task[]     @relation("SubTasks")
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])

  comments    Comment[]
  timeEntries TimeEntry[]
  labels      String[]    @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("milestones")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // AI-generated flag
  isAiGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  subtotal      Decimal       @db.Decimal(15, 2)
  tax           Decimal       @default(0) @db.Decimal(15, 2)
  discount      Decimal       @default(0) @db.Decimal(15, 2)
  total         Decimal       @db.Decimal(15, 2)
  totalUsd      Decimal?      @db.Decimal(15, 2)
  currency      Currency      @default(VND)
  notes         String?

  // Relations
  projectId String?
  project   Project?      @relation(fields: [projectId], references: [id])
  clientId  String
  client    User          @relation("InvoiceClient", fields: [clientId], references: [id])
  creatorId String
  creator   User          @relation("InvoiceCreator", fields: [creatorId], references: [id])
  items     InvoiceItem[]

  paidAt        DateTime?
  paidAmount    Decimal?  @db.Decimal(15, 2)
  paymentMethod String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Float   @default(1)
  unitPrice   Decimal @db.Decimal(15, 2)
  amount      Decimal @db.Decimal(15, 2)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model TimeEntry {
  id          String   @id @default(cuid())
  description String?
  hours       Float
  date        DateTime @default(now())
  billable    Boolean  @default(true)

  userId String
  user   User    @relation(fields: [userId], references: [id])
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])

  createdAt DateTime @default(now())

  @@map("time_entries")
}

model ProjectFile {
  id         String  @id @default(cuid())
  name       String
  url        String
  mimeType   String
  size       Int
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy String

  createdAt DateTime @default(now())

  @@map("project_files")
}

model Notification {
  id      String           @id @default(cuid())
  type    NotificationType
  title   String
  message String
  isRead  Boolean          @default(false)
  data    Json?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model AiConversation {
  id       String      @id @default(cuid())
  title    String?
  context  String?
  userId   String
  user     User        @relation(fields: [userId], references: [id])
  messages AiMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(cuid())
  role           String
  content        String
  tokenUsage     Int?
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("ai_messages")
}

model AiUsageAudit {
  id                 String    @id @default(cuid())
  feature            AiFeature
  model              String?
  success            Boolean   @default(true)
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  estimatedCostUsd   Decimal?  @db.Decimal(12, 6)
  durationMs         Int?
  errorMessage       String?
  metadata           Json?
  effectivenessScore Int?
  feedbackNote       String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([feature, createdAt])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@map("ai_usage_audits")
}

model AiApplyRequest {
  id          String               @id @default(cuid())
  status      AiApplyRequestStatus @default(PENDING)
  plan        Json
  objective   String?
  constraints String?
  notes       String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  requesterId String
  requester   User   @relation("AiApplyRequester", fields: [requesterId], references: [id])

  reviewerId String?
  reviewer   User?   @relation("AiApplyReviewer", fields: [reviewerId], references: [id])

  reviewedAt DateTime?
  appliedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([requesterId, createdAt])
  @@index([status, createdAt])
  @@map("ai_apply_requests")
}

model Activity {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  details    Json?
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@map("activities")
}

model Message {
  id         String   @id @default(cuid())
  content    String
  senderId   String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([projectId])
  @@map("messages")
}

enum ContactRequestStatus {
  NEW
  REVIEWED
  CONTACTED
  CONVERTED
  CLOSED
}

model ContactRequest {
  id        String               @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  service   String?
  budget    String?
  message   String
  status    ContactRequestStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@map("contact_requests")
}

model SiteContent {
  id        String   @id @default(cuid())
  section   String   @unique
  data      Json
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("site_contents")
}

// CMS override layer for i18n messages. One independent row per (namespace, locale)
// — locales never share a record, so editing VI can't clobber EN (the root cause of
// the old per-locale-envelope bug). `data` is a deep-partial of the next-intl
// namespace; it is merged over the static messages/{locale}.json at render time.
model ContentOverride {
  id        String   @id @default(cuid())
  namespace String
  locale    Language
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([namespace, locale])
  @@map("content_overrides")
}

// Pattern: Aggregate Root — a published blog post is the unit of public CMS content
// for organic SEO. `(locale, slug)` is unique so the same content can be re-slugged
// per locale. `contentMdx` is rendered server-side at request time (GĐ1) and later
// cached as static via ISR once volume grows (GĐ2).
model BlogPost {
  id            String         @id @default(cuid())
  slug          String
  locale        Language
  title         String
  excerpt       String?
  contentMdx    String
  coverImageUrl String?
  tags          String[]       @default([])
  status        BlogPostStatus @default(DRAFT)
  publishedAt   DateTime?

  authorId String
  author   User   @relation("BlogPostAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, slug])
  @@index([locale, status, publishedAt])
  @@index([status, publishedAt])
  @@map("blog_posts")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String
  p256dh    String
  auth      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

// ==================== RAG (AI Core, GĐ2) ====================
// Tenant-isolated knowledge base: documents belong to a client (User role CLIENT).
// NOTE: the migration must enable pgvector and add the vector column + index by
// hand (Prisma manages everything except the Unsupported `embedding` column):
//   CREATE EXTENSION IF NOT EXISTS vector;
//   ALTER TABLE rag_chunks ADD COLUMN embedding vector(1024);
//   CREATE INDEX rag_chunks_embedding_idx ON rag_chunks
//     USING hnsw (embedding vector_cosine_ops);

model RagDocument {
  id               String            @id @default(cuid())
  title            String
  source           RagDocumentSource @default(UPLOAD)
  originalFilename String?
  mimeType         String?
  status           RagDocumentStatus @default(PENDING)
  error            String?
  chunkCount       Int               @default(0)

  // Tenant scope — the client who owns this document (plan §5.1 isolation).
  clientId String
  client   User   @relation("RagDocumentClient", fields: [clientId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("RagDocumentUploader", fields: [uploadedById], references: [id])

  chunks RagChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@map("rag_documents")
}

model RagChunk {
  id         String      @id @default(cuid())
  documentId String
  document   RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Denormalized for fast tenant-filtered similarity search.
  clientId String

  chunkIndex Int
  content    String
  tokenCount Int?

  // pgvector — Voyage voyage-3 = 1024 dims. Queried via $queryRaw, not the typed client.
  embedding Unsupported("vector(1024)")?

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([documentId])
  @@map("rag_chunks")
}

// Pattern: Human-in-the-loop (plan §3.4 / §5.2) — a generated answer is a DRAFT
// until a human reviews it; never auto-delivered to the client.
model RagAnswer {
  id            String          @id @default(cuid())
  question      String
  draftAnswer   String
  citedChunkIds String[]        @default([])
  status        RagAnswerStatus @default(DRAFT)

  clientId String
  client   User   @relation("RagAnswerClient", fields: [clientId], references: [id], onDelete: Cascade)

  askedById String
  askedBy   User   @relation("RagAnswerAsker", fields: [askedById], references: [id])

  reviewerId String?
  reviewer   User?     @relation("RagAnswerReviewer", fields: [reviewerId], references: [id])
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([askedById, createdAt])
  @@map("rag_answers")
}

// ==================== ACADEMY (Dịch vụ 2, GĐ2) ====================
// A Playbook is a packaged AI-usage handbook authored by staff, published, then
// assigned to clients. Delivery is tenant-scoped via PlaybookAssignment.

model Playbook {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  summary     String?
  contentMdx  String
  tags        String[]       @default([])
  status      PlaybookStatus @default(DRAFT)
  publishedAt DateTime?

  authorId String
  author   User   @relation("PlaybookAuthor", fields: [authorId], references: [id])

  assignments PlaybookAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@map("playbooks")
}

model PlaybookAssignment {
  id     String                   @id @default(cuid())
  status PlaybookAssignmentStatus @default(ASSIGNED)

  playbookId String
  playbook   Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  // Tenant scope — the client this playbook is delivered to (plan §5.1).
  clientId String
  client   User   @relation("PlaybookAssignmentClient", fields: [clientId], references: [id], onDelete: Cascade)

  assignedById String
  assignedBy   User   @relation("PlaybookAssignmentAssigner", fields: [assignedById], references: [id])

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playbookId, clientId])
  @@index([clientId, status])
  @@map("playbook_assignments")
}
