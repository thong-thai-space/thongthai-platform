# Database
DATABASE_URL="postgresql://user:password@localhost:5432/thongthai_space?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-key"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:3000"

# Port
PORT=4000

# Redis
REDIS_URL="redis://localhost:6379"

# Anthropic AI
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Resend (Email)
RESEND_API_KEY=""
MAIL_FROM="Thông Thái Space <noreply@thongthai.space>"
