NODE_ENV=production
PORT=4000
POSTGRES_USER=thongthai
POSTGRES_DB=thongthai_space
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Database
DATABASE_URL=postgresql://thongthai:CHANGE_ME_DB_PASSWORD@postgres:5432/thongthai_space?schema=public

# Cache
REDIS_URL=redis://redis:6379

# CORS
FRONTEND_URL=https://your-frontend-domain.com

# JWT
JWT_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY

# Optional integrations
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
RESEND_API_KEY=
